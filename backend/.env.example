# General application settings
PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/quick_tix_db"
JWT_SECRET_KEY="your-32-character-jwt-secret-key-here-change-this"
EMAIL_SECRET_KEY="your-32-character-email-secret-key-here-change-this"
REFRESH_SECRET_KEY="your-32-character-refresh-secret-key-here-change-this"
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"
RESEND_API_KEY="your-resend-api-key"

# Khalti Payment Gateway Configuration
# Get these from your Khalti merchant dashboard: https://khalti.com/
KHALTI_LIVE_SECRET_KEY="your-khalti-live-secret-key"
KHALTI_LIVE_PUBLIC_KEY="your-khalti-live-public-key"
KHALTI_PAYMENT_URL="https://khalti.com/api/v2/epayment/initiate/"
KHALTI_LOOKUP_URL="https://khalti.com/api/v2/epayment/lookup/"

# eSewa Payment Gateway Configuration
# Get these from your eSewa merchant account: https://esewa.com.np/
ESEWA_MERCHANT_CODE="EPAYTEST"  # Use "EPAYTEST" for testing, your merchant code for production
ESEWA_SECRET_KEY="your-esewa-secret-key"
ESEWA_PAYMENT_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"

# Payment Success/Failure URLs
SUCCESS_URL="http://localhost:3000/api/payments/success"
FAILURE_URL="http://localhost:3000/api/payments/failure"

# Cloudinary Configuration
CLOUD_NAME="your-cloudinary-cloud-name"
API_KEY="your-cloudinary-api-key"
API_SECRET="your-cloudinary-api-secret"