generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ORGANIZER
  ATTENDEE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  verified  Boolean  @default(false)
  password  String
  role      UserRole @default(ATTENDEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendeeProfile  AttendeeProfile?
  organizerProfile OrganizerProfile?
  uploadedMedia    Media[]           @relation("UploadedByUser")
  seatReservations SeatReservation[]
}

model AttendeeProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  bio       String?
  phone     String?
  avatarId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar   Media?    @relation("AttendeeAvatar", fields: [avatarId], references: [id])
  bookings Booking[]

  @@index([userId])
}

model OrganizerProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  organizationName String
  bio              String?
  phone            String?
  website          String?
  contactEmail     String
  kycVerified      Boolean  @default(false)
  avatarId         Int?
  coverId          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar          Media?  @relation("OrganizerAvatar", fields: [avatarId], references: [id])
  cover           Media?  @relation("OrganizerCover", fields: [coverId], references: [id])
  organizedEvents Event[]

  @@index([userId])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  location    String
  capacity    Int?
  organizerId Int
  venueId     Int?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  venue       Venue?           @relation(fields: [venueId], references: [id])
  bookings    Booking[]
  ticketTypes TicketType[]
  media       Media[]          @relation("EventMedia") // multiple images/videos per event

  @@index([organizerId])
  @@index([venueId])
}

model Venue {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  events   Event[]
}

model Section {
  id        Int      @id @default(autoincrement())
  name      String
  capacity  Int?
  venueId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@unique([venueId, name])
}

model Seat {
  id           Int      @id @default(autoincrement())
  label        String
  sectionId    Int
  bookingId    Int?
  ticketTypeId Int?
  isBooked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  ticketType      TicketType?      @relation(fields: [ticketTypeId], references: [id])
  seatReservation SeatReservation?

  @@unique([sectionId, label])
  @@index([bookingId])
  @@index([ticketTypeId])
}

model SeatReservation {
  id        Int      @id @default(autoincrement())
  seatId    Int      @unique
  userId    Int
  eventId   Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model TicketType {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  capacity    Int?
  sold        Int      @default(0)
  eventId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  seats      Seat[]
  facilities Facility[]

  @@unique([eventId, name])
  @@index([eventId])
}

model Facility {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  ticketTypeId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([ticketTypeId, name])
}

model Ticket {
  id         Int      @id @default(autoincrement())
  typeId     Int
  quantity   Int
  totalPrice Float
  bookingId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  ticketType TicketType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([typeId])
  @@index([bookingId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CARD
  ESEWA
  KHALTI
  STRIPE
  CASH
}

model Booking {
  id            Int           @id @default(autoincrement())
  eventId       Int
  attendeeId    Int
  status        BookingStatus @default(PENDING)
  totalPrice    Float         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee AttendeeProfile @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  tickets  Ticket[]
  seats    Seat[]
  payment  Payment?

  @@unique([eventId, attendeeId])
  @@index([eventId])
  @@index([attendeeId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  amount          Float
  bookingId       Int           @unique
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  transactionId   String?
  provider        String?
  currency        String        @default("NPR")
  paidAt          DateTime?
  refundReason    String?
  gatewayResponse Json?
  expiresAt       DateTime?
  paymentUrl      String?
  pidx            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([transactionId])
  @@index([pidx])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id         Int       @id @default(autoincrement())
  url        String
  type       MediaType
  size       Int?
  altText    String?
  uploadedBy Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  uploadedByUser   User?              @relation("UploadedByUser", fields: [uploadedBy], references: [id])
  attendeeProfiles AttendeeProfile[]  @relation("AttendeeAvatar")
  organizerAvatars OrganizerProfile[] @relation("OrganizerAvatar")
  organizerCovers  OrganizerProfile[] @relation("OrganizerCover")
  eventMedia       Event[]            @relation("EventMedia")
}
