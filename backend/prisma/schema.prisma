generator erd {
  provider = "prisma-erd-generator"
  output   = "./erd.svg"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  fullName           String
  username           String            @unique
  email              String            @unique
  password           String
  role               Role              @default(ATTENDEE)
  image              String?
  organizerProfileId Int?
  organizerProfile   OrganizerProfile? @relation(fields: [organizerProfileId], references: [id])
  verified           Boolean           @default(false)
  Seat               Seat[]
  bookings           Booking[]
  events             Event[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("users")
}

model OrganizerProfile {
  id              Int     @id @default(autoincrement())
  businessName    String
  organizedEvents Event[]
  isKycVerified   Boolean @default(false)
  User            User[]
}

model Event {
  id                 Int               @id @default(autoincrement())
  title              String
  description        String
  category           EventCategory     @default(OTHERS)
  images             String[]
  tags               String?
  date               DateTime
  agenda             Agenda            @relation(fields: [agendaId], references: [id])
  agendaId           Int
  OrganizerProfile   OrganizerProfile? @relation(fields: [organizerProfileId], references: [id])
  organizerProfileId Int?

  Sponsors    Sponsors[]
  ticketTypes TicketType[]
  Venue       Venue?       @relation(fields: [venueId], references: [id])
  venueId     Int?
  Location    Location?    @relation(fields: [locationId], references: [id])
  locationId  Int?
  attendees   User[]

  @@index([date])
  @@index([category])
  @@map("events")
}

model Agenda {
  id       Int      @id @default(autoincrement())
  time     DateTime
  activity String
  Event    Event[]
}

model Sponsors {
  id      Int     @id @unique @default(autoincrement())
  name    String
  website String?
  eventId Int?
  Event   Event?  @relation(fields: [eventId], references: [id])
}

model Venue {
  id          Int      @id @default(autoincrement())
  name        String
  capacity    Int
  amenities   String[]
  description String?
  locationId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  location    Location @relation(fields: [locationId], references: [id])
  events      Event[]
}

model Location {
  id        Int      @id @default(autoincrement())
  address   String
  city      String
  state     String
  country   String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venues    Venue[]
  events    Event[]
}

model Booking {
  id           Int           @id @default(autoincrement())
  eventId      Int
  userId       Int
  ticketCounts Int
  totalPrice   Float
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  event        Event         @relation(fields: [eventId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  payments     Payment?

  @@index([eventId])
  @@index([userId])
  @@map("bookings")
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int           @unique
  amount          Float
  paymentProvider String
  paymentStatus   PaymentStatus @default(PENDING)
  transactionId   String?
  paymentResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model TicketType {
  id       Int    @id @default(autoincrement())
  name     String
  features Json

  createdAt DateTime @default(Date.now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ORGANIZER
  ATTENDEE
}

enum TicketAvailability {
  AVAILABLE
  SOLD_OUT
}

enum EventCategory {
  MUSIC_CONCERTS
  STANDUP_COMEDY
  IMPROV_COMEDY
  THEATER_PERFORMANCES
  MUSICALS
  OPERA
  DANCE_PERFORMANCES
  MAGIC_SHOWS
  FESTIVALS
  SPORTS_EVENTS
  TALENT_SHOWS
  WORKSHOPS_CLASSES
  CONFERENCES_TALKS
  FAMILY_KIDS_EVENTS
  VIRTUAL_EVENTS
  OTHERS
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum BookingStatus {
  FAILED
  PENDING
  SUCCESSFUL
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  LOCKED
}

enum PaymentMethod {
  ESEWA
  KHALTI
}
