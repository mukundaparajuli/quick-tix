generator erd {
  provider = "prisma-erd-generator"
  output   = "./erd.svg"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  fullName           String
  username           String            @unique
  email              String            @unique
  password           String
  role               Role              @default(ATTENDEE)
  image              String?
  organizerProfileId Int?              @unique
  organizerProfile   OrganizerProfile?
  verified           Boolean           @default(false)
  bookings           Booking[]
  events             Event[]           @relation("EventAttendees")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  createdBy          Int? // Track who created the user (admin or self)
  updatedBy          Int? // Track who updated the user
  Location           Location?         @relation(fields: [locationId], references: [id])
  locationId         Int?

  @@map("users")
}

model OrganizerProfile {
  id              Int       @id @default(autoincrement())
  businessName    String
  organizedEvents Event[]
  isKycVerified   Boolean   @default(false)
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("organizer_profiles")
}

model Event {
  id                 Int               @id @default(autoincrement())
  title              String
  description        String
  category           EventCategory     @default(OTHERS)
  images             String[]
  tags               String[]
  date               DateTime
  agendaId           Int?
  agenda             Agenda?           @relation(fields: [agendaId], references: [id], onDelete: SetNull)
  organizerProfileId Int?
  organizerProfile   OrganizerProfile? @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)
  venueId            Int?
  venue              Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  locationId         Int?
  location           Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ticketTypes        TicketType[]
  sponsors           Sponsor[]
  bookings           Booking[]
  attendees          User[]            @relation("EventAttendees")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  Promocode          Promocode[]

  @@index([date])
  @@index([category])
  @@index([organizerProfileId])
  @@map("events")
}

model Agenda {
  id        Int       @id @default(autoincrement())
  time      DateTime
  activity  String
  events    Event[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("agendas")
}

model Sponsor {
  id        Int       @id @default(autoincrement())
  name      String
  website   String?
  eventId   Int
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("sponsors")
}

model Venue {
  id          Int       @id @default(autoincrement())
  name        String
  capacity    Int
  amenities   String[]
  description String?
  locationId  Int
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  events      Event[]
  seats       Seat[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("venues")
}

model Location {
  id        Int       @id @default(autoincrement())
  address   String
  city      String
  state     String
  country   String
  latitude  Float?
  longitude Float?
  venues    Venue[]
  events    Event[]
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("locations")
}

model TicketType {
  id                Int                @id @default(autoincrement())
  eventId           Int
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  price             Float
  totalQuantity     Int
  availableQuantity Int
  features          Json?
  bookings          Booking[]
  seats             Seat[]
  availability      TicketAvailability @default(AVAILABLE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([eventId])
  @@map("ticket_types")
}

model Seat {
  id           Int        @id @default(autoincrement())
  venueId      Int
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  ticketTypeId Int
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  bookingId    Int?
  booking      Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  seatNumber   String
  row          String?
  section      String?
  status       SeatStatus @default(AVAILABLE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([venueId, seatNumber, row, section])
  @@index([venueId])
  @@index([ticketTypeId])
  @@index([bookingId])
  @@map("seats")
}

model Booking {
  id           Int           @id @default(autoincrement())
  eventId      Int
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ticketTypeId Int
  ticketType   TicketType    @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  ticketCount  Int
  totalPrice   Float
  promocodeId  Int?
  promocode    Promocode?    @relation(fields: [promocodeId], references: [id], onDelete: SetNull)
  seats        Seat[]
  status       BookingStatus @default(PENDING)
  payment      Payment?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([eventId])
  @@index([userId])
  @@index([ticketTypeId])
  @@map("bookings")
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int           @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Float
  paymentProvider PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  transactionId   String?       @unique
  paymentResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@map("payments")
}

model Promocode {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  discount     Float
  discountType DiscountType
  eventId      Int?
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  maxUses      Int?
  usedCount    Int          @default(0)
  validFrom    DateTime
  validUntil   DateTime
  bookings     Booking[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([eventId])
  @@map("promocodes")
}

enum Role {
  ORGANIZER
  ATTENDEE
  ADMIN
}

enum TicketAvailability {
  AVAILABLE
  SOLD_OUT
}

enum EventCategory {
  MUSIC_CONCERTS
  STANDUP_COMEDY
  IMPROV_COMEDY
  THEATER_PERFORMANCES
  MUSICALS
  OPERA
  DANCE_PERFORMANCES
  MAGIC_SHOWS
  FESTIVALS
  SPORTS_EVENTS
  TALENT_SHOWS
  WORKSHOPS_CLASSES
  CONFERENCES_TALKS
  FAMILY_KIDS_EVENTS
  VIRTUAL_EVENTS
  OTHERS
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  LOCKED
}

enum PaymentMethod {
  ESEWA
  KHALTI
  CREDIT_CARD
  PAYPAL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
